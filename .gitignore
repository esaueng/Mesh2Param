dist/
build/
# ...but not the Rust core's face-construction module, which the blanket
# `build/` rule above (aimed at JS and Python output) would otherwise swallow
# whole.
!/crates/mesh2param-core/src/build/
*.egg-info/
.coverage
coverage.xml
htmlcov/
playwright-report/
test-results/
output/playwright/
artifacts/acceptance/
artifacts/curved-baseline/

# Rust build output. Cargo.lock is committed on purpose: the workspace ships a
# binary-shaped artifact and pins its kernel by revision, so the resolved graph
# has to be reproducible.
/target/

# Rust spike build output
spikes/*/target/
