# Copy to .env for Docker Compose. The app reads process variables, not dotenv files;
# this container profile therefore cannot silently replace the local development profile.
MESH2PARAM_ENVIRONMENT=production

# P0 persistence and queue: local SQLite plus filesystem, shared by API and worker.
MESH2PARAM_DATA_DIR=/var/lib/mesh2param
MESH2PARAM_DATABASE_URL=sqlite:////var/lib/mesh2param/db/mesh2param.sqlite3
MESH2PARAM_STORAGE_PATH=/var/lib/mesh2param/storage

# Optional future backends are intentionally unsupported in M5. Do not uncomment these values:
# startup fails closed instead of silently weakening filesystem storage or the SQLite queue.
# MESH2PARAM_QUEUE_URL=redis://queue.example.invalid:6379/0
# MESH2PARAM_S3_ENDPOINT=https://s3.example.invalid
# MESH2PARAM_S3_BUCKET=mesh2param

# Public/single-origin addresses. The browser uses relative /api.
MESH2PARAM_PUBLIC_URL=http://localhost:8080
MESH2PARAM_API_URL=http://api:8000
MESH2PARAM_BIND_HOST=0.0.0.0
MESH2PARAM_PORT=8000
MESH2PARAM_ALLOWED_HOSTS=localhost,127.0.0.1
MESH2PARAM_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional shared bearer token for every /api request. Leave blank for loopback-only use.
# Set this through your secret manager in production; never commit the real value.
MESH2PARAM_API_TOKEN=

# Untrusted-input and job bounds.
MESH2PARAM_MAX_UPLOAD_MB=100
MESH2PARAM_MAX_TRIANGLES=2000000
MESH2PARAM_MAX_VERTICES=6000000
MESH2PARAM_MAX_ABS_COORDINATE=1000000000
MESH2PARAM_MAX_OPERATION_COUNT=256
MESH2PARAM_MAX_SEARCH_REBUILDS=128
MESH2PARAM_JOB_TIMEOUT_SECONDS=900
MESH2PARAM_RETENTION_DAYS=30
MESH2PARAM_GARBAGE_COLLECTION_INTERVAL_SECONDS=3600
MESH2PARAM_GARBAGE_COLLECTION_BATCH_SIZE=500

# Runtime behavior. External mode keeps geometry work in the no-network worker container.
# Compose sets external mode on both API and worker. The worker owns job execution.
MESH2PARAM_JOB_RUNNER_MODE=external
MESH2PARAM_WORKER_COUNT=1
MESH2PARAM_WORKER_MEMORY_MB=1024
MESH2PARAM_LOG_LEVEL=INFO
MESH2PARAM_DEBUG=false

# Compose also accepts optional shell-only COMPOSE_* overrides for API/worker/web CPU,
# memory, web port, and image tag. They are intentionally omitted so only recognized backend
# settings appear here; absolute /var paths target the Linux containers, not the macOS host.
# The locked backend is intentionally linux/amd64 because nlopt has no CPython 3.12 Linux ARM wheel.
# If COMPOSE_WEB_PORT is overridden in the shell, update PUBLIC_URL and CORS_ORIGINS to match it.
